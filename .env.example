# --- Local Docker (docker-compose.yml) uses embedded Postgres ---
# --- Production (docker-compose.prod.yml) uses Neon ---

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Pump geofence
PUMP_LAT=13.765987
PUMP_LNG=76.852652
PUMP_RADIUS_METERS=50

# OTP: console (logs only) | twilio (SMS)
OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Neon (production DB) ---
# In Neon console: Connection details → copy host, db, user, password
# Use the POOLED host when offered (...-pooler....neon.tech)
# Example JDBC (ssl required):
# DATABASE_URL=jdbc:postgresql://ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=jdbc:postgresql://ep-YOUR-ENDPOINT.region.aws.neon.tech/neondb?sslmode=require
DATABASE_USER=
DATABASE_PASSWORD=

# Optional image tag when pulling from GHCR
IMAGE_TAG=latest

# Local-only compose still accepts this if you use docker-compose.yml postgres:
# DATABASE_PASSWORD=discount
